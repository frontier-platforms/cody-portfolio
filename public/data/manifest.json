          "sql": "select count(*) as failures from (\nwith child as (\n    select game_id as from_field\n    from {{ ref('flames_shots') }}\n    where game_id is not null\n),\n\nparent as (\n    select game_id as to_field\n    from {{ ref('flames_games') }}\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n) dbt_test"
