          "sql": "SELECT count(*) AS failures FROM main.flames_shots c\nWHERE c.game_id IS NOT NULL\n  AND NOT EXISTS (SELECT 1 FROM main.flames_games p WHERE p.game_id = c.game_id)"
        },
        {
          "name": "Coordinates are on the ice",
          "model": "flames_shots",
          "kind": "expression",
          "severity": "error",
          "status": "pass",
          "failures": 0,
          "ms": 0.14720899999520043,
          "sql": "SELECT count(*) AS failures FROM main.flames_shots WHERE NOT (x BETWEEN -100 AND 100 AND y BETWEEN -43 AND 43)"
        },
        {
          "name": "Shot-level goals reconcile to the final score",
          "model": "flames_games",
          "kind": "custom",
          "severity": "error",
          "status": "pass",
          "failures": 0,
          "ms": 1.5734169999996084,
          "sql": "\nWITH shot_goals AS (\n  SELECT game_id,\n         count(*) FILTER (WHERE is_goal AND team = 'CGY') AS gf,\n         count(*) FILTER (WHERE is_goal AND team = 'OPP') AS ga\n  FROM main.flames_shots\n  GROUP BY 1\n)\nSELECT count(*) AS failures\nFROM main.flames_games g\nLEFT JOIN shot_goals s USING (game_id)\nWHERE g.goals_for - (g.decided_in = 'SO' AND g.result = 'W')::INTEGER <> COALESCE(s.gf, 0)\n   OR g.goals_against - (g.decided_in = 'SO' AND g.result <> 'W')::INTEGER <> COALESCE(s.ga, 0)"
        },
        {
          "name": "Coordinate flip points shots at the attacking net",
          "model": "flames_shots",
          "kind": "custom",
          "severity": "warn",
          "status": "pass",
          "failures": 0,
          "ms": 0.6549579999991693,
          "sql": "\nSELECT CASE WHEN avg((x > 0)::INTEGER) >= 0.95 THEN 0 ELSE 1 END AS failures\nFROM main.flames_shots\nWHERE event <> 'blocked-shot'"
        },
