          "kind": "not_null",
          "severity": "warn",
          "status": "pass",
          "failures": 0,
          "ms": 0.12354100000084145,
          "sql": "SELECT count(*) AS failures FROM main.flames_shots WHERE shooter IS NULL"
        }
