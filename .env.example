# Claude API key for the "Ask the data" feature (server-side only).
# Without it, /api/ask returns 503 and the rest of the site works normally.
# Set a monthly spend limit on this key in the Anthropic Console.
ANTHROPIC_API_KEY=

# Formspree form ID for the contact form (formspree.io/f/<id>). Public by design:
# Formspree stores submissions and emails them. Without it, the form shows the email address.
NEXT_PUBLIC_FORMSPREE_ID=

# Canonical URL, used for metadata, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://example.com
