# Copy to .env and fill in real values. .env is gitignored — never commit it.
# This file documents every variable the project uses, grouped by layer. Variables with no
# value yet are for phases we haven't built — leave them blank until then.

# --- Azure (Phase 1) ---
# Found via `az account show` once you're logged in with `az login`.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=canadacentral
AZURE_RESOURCE_GROUP=rg-insurance-analytics

# --- Source Postgres (Phase 2) ---
# Azure Database for PostgreSQL, Flexible Server.
PGHOST=
PGPORT=5432
PGDATABASE=insurance
PGUSER=
PGPASSWORD=

# --- Airbyte (Phase 2) ---
AIRBYTE_WORKSPACE_URL=http://localhost:8000

# --- Snowflake (Phase 1/4) ---
# Account identifier looks like "abcd-xy12345" (organization-account), not a URL.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_ORG=
# Service users authenticate with an RSA key pair, never a password.
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_SCHEMA=DBT_CODY

# --- Bordereau export / SFTP (Phase 5) ---
AZURE_STORAGE_ACCOUNT=
SFTP_HOST=
SFTP_USER=

# --- Cortex Agent / AI chat (Phase 6) ---
CORTEX_AGENT_ENDPOINT=

# --- Front-end apps (Phase 7) ---
# Option C (custom Next.js) back end reads Snowflake creds via the service user above.
NEXT_PUBLIC_APP_NAME="Insurance Analytics Platform"
LIGHTDASH_SECRET=
