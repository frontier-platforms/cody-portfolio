# Copy to .env (gitignored) and fill in real values.

# Lightdash's own metadata Postgres (the `db` service in docker-compose.yml) - not the
# insurance data, that's reached via Lightdash's Snowflake connection, configured
# inside the app itself (role/warehouse/database come from LIGHTDASH_SVC, see
# infra/snowflake).
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres

# Generate once with: openssl rand -hex 32
# Encrypts stored warehouse credentials - changing this after setup locks you out of
# anything already saved in Lightdash, so keep it fixed once chosen.
LIGHTDASH_SECRET=

PORT=8080
SITE_URL=http://localhost:8080
